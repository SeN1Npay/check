{
  "id": "sakura",
  "name": "Sakura",
  "description": "Ночь цветения сакуры: мягкий розовый акцент, «остров» и Мета-тян в тон.",
  "author": "Metamorph",
  "mode": "dark",
  "palette": {
    "background": "#1F1A24",
    "surface": "#2E2533",
    "foreground": "#F5E6EE",
    "muted": "#8A7484",
    "accent": "#FF8FAB",
    "accent2": "#C3A6FF",
    "red": "#FF5C7A",
    "green": "#A6E3A1",
    "yellow": "#FFD6A5"
  },
  "wallpaper": {
    "kind": "gradient",
    "from": "#2A1F2D",
    "to": "#4A2F45",
    "direction": "vertical",
    "style": "fill"
  },
  "system": {
    "transparency": true,
    "accentOnTaskbar": true,
    "accentOnTitleBars": false
  },
  "taskbar": {
    "mode": "hidden"
  },
  "bar": {
    "enabled": true,
    "position": "top",
    "height": 28,
    "opacity": 0.75,
    "blur": true,
    "fontFamily": "JetBrains Mono, Cascadia Mono, Consolas",
    "fontSize": 13,
    "clockFormat": "ddd dd MMM  HH:mm",
    "left": [
      "launcher",
      "workspaces",
      "window"
    ],
    "center": [],
    "right": [
      "media",
      "weather",
      "layout",
      "volume",
      "battery",
      "clock",
      "tray"
    ],
    "style": "islands"
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "behavior": "dodgeWindows",
    "style": "glass",
    "iconSize": 48,
    "hoverEffect": "magnify",
    "magnification": 1.7,
    "magnifyRange": 2.5,
    "spacing": 8,
    "padding": 9,
    "margin": 8,
    "cornerRadius": 18,
    "opacity": 0.7,
    "indicator": "dot",
    "bounceOnLaunch": true,
    "bounceOnAttention": true,
    "showLabels": true,
    "showAppsButton": true,
    "showTrash": true,
    "showRunningApps": true,
    "animationSpeed": 1.0
  },
  "island": {
    "enabled": true,
    "screens": "primary",
    "overBar": false,
    "offset": 6,
    "height": 34,
    "width": 250,
    "expandedWidth": 400,
    "idle": "clock",
    "opacity": 0.92,
    "albumArt": true,
    "visualizer": true,
    "expandOnHover": true,
    "trackPopupSeconds": 3,
    "activities": [
      "volume",
      "layout",
      "capslock",
      "battery",
      "theme",
      "privacy",
      "network"
    ],
    "animationSpeed": 1.0,
    "hideInFullscreen": true,
    "clockFormat": "HH:mm"
  }
}
