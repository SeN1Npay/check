{
  "id": "cyberpunk",
  "name": "Cyberpunk",
  "description": "Неон: розовый, жёлтый и бирюзовый, powerline-панель и градиентная рамка окон.",
  "author": "Metamorph",
  "mode": "dark",
  "palette": {
    "background": "#0D0221",
    "surface": "#1B0B3A",
    "foreground": "#F2F2F2",
    "muted": "#6B5B95",
    "accent": "#FCEE0A",
    "accent2": "#00F0FF",
    "red": "#FF2A6D",
    "green": "#05FFA1",
    "yellow": "#FCEE0A"
  },
  "wallpaper": {
    "kind": "gradient",
    "from": "#0B0220",
    "to": "#2D0B4E",
    "direction": "vertical",
    "style": "fill"
  },
  "system": {
    "transparency": true,
    "accentOnTaskbar": true,
    "accentOnTitleBars": false
  },
  "taskbar": {
    "mode": "hidden"
  },
  "bar": {
    "enabled": true,
    "position": "top",
    "height": 28,
    "opacity": 0.85,
    "blur": true,
    "fontFamily": "JetBrains Mono, Cascadia Mono, Consolas",
    "fontSize": 13,
    "clockFormat": "ddd dd MMM  HH:mm",
    "left": [
      "launcher",
      "workspaces",
      "window"
    ],
    "center": [],
    "right": [
      "cava",
      "cpu",
      "gpu",
      "volume",
      "network",
      "clock",
      "tray"
    ],
    "style": "powerline"
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "behavior": "dodgeWindows",
    "style": "glass",
    "iconSize": 48,
    "hoverEffect": "magnify",
    "magnification": 1.8,
    "magnifyRange": 2.5,
    "spacing": 8,
    "padding": 9,
    "margin": 8,
    "cornerRadius": 18,
    "opacity": 0.7,
    "indicator": "line",
    "bounceOnLaunch": true,
    "bounceOnAttention": true,
    "showLabels": true,
    "showAppsButton": true,
    "showTrash": true,
    "showRunningApps": true,
    "animationSpeed": 1.0
  },
  "island": {
    "enabled": true,
    "screens": "primary",
    "overBar": false,
    "offset": 0,
    "height": 34,
    "width": 250,
    "expandedWidth": 400,
    "idle": "clock",
    "opacity": 0.92,
    "albumArt": true,
    "visualizer": true,
    "expandOnHover": true,
    "trackPopupSeconds": 3,
    "activities": [
      "volume",
      "layout",
      "capslock",
      "battery",
      "theme",
      "privacy",
      "network"
    ],
    "animationSpeed": 1.0,
    "hideInFullscreen": true,
    "clockFormat": "HH:mm",
    "style": "notch"
  },
  "windows": {
    "activeBorder": {
      "enabled": true,
      "width": 3,
      "gradient": true,
      "radius": 8
    },
    "tiling": {
      "hotkeys": true,
      "gaps": 10,
      "masterRatio": 0.55,
      "engine": "none"
    }
  }
}
