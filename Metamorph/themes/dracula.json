{
  "id": "dracula",
  "name": "Dracula",
  "description": "Классическая фиолетово-розовая тёмная тема.",
  "author": "Metamorph",
  "mode": "dark",
  "palette": {
    "background": "#282A36",
    "surface": "#44475A",
    "foreground": "#F8F8F2",
    "muted": "#6272A4",
    "accent": "#BD93F9",
    "accent2": "#FF79C6",
    "red": "#FF5555",
    "green": "#50FA7B",
    "yellow": "#F1FA8C"
  },
  "wallpaper": {
    "kind": "gradient",
    "from": "#21222C",
    "to": "#44475A",
    "direction": "diagonal",
    "style": "fill"
  },
  "system": {
    "transparency": true,
    "accentOnTaskbar": true,
    "accentOnTitleBars": true
  },
  "taskbar": {
    "mode": "hidden"
  },
  "bar": {
    "enabled": true,
    "position": "top",
    "height": 28,
    "opacity": 0.85,
    "blur": true,
    "fontFamily": "JetBrains Mono, Cascadia Mono, Consolas",
    "fontSize": 13,
    "clockFormat": "ddd dd MMM  HH:mm",
    "left": [
      "launcher",
      "window"
    ],
    "center": [
      "clock"
    ],
    "right": [
      "layout",
      "cpu",
      "ram",
      "battery",
      "uptime",
      "tray"
    ]
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "behavior": "alwaysVisible",
    "style": "pill",
    "iconSize": 48,
    "hoverEffect": "magnify",
    "magnification": 1.8,
    "magnifyRange": 2.5,
    "spacing": 8,
    "padding": 9,
    "margin": 8,
    "cornerRadius": 18,
    "opacity": 0.82,
    "indicator": "dot",
    "bounceOnLaunch": true,
    "bounceOnAttention": true,
    "showLabels": true,
    "showAppsButton": true,
    "showTrash": true,
    "showRunningApps": true,
    "animationSpeed": 1.0
  }
}
