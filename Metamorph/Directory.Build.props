<Project>
  <!--
    MM_AGENT=<имя> выносит bin/obj в /tmp/mmbuild/<имя>/, чтобы несколько сборок могли идти параллельно.
    Обычная сборка (без переменной) использует стандартные bin/ и obj/.
  -->
  <PropertyGroup Condition="'$(MM_AGENT)' != ''">
    <BaseIntermediateOutputPath>/tmp/mmbuild/$(MM_AGENT)/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <BaseOutputPath>/tmp/mmbuild/$(MM_AGENT)/$(MSBuildProjectName)/bin/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
